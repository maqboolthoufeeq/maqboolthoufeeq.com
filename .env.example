# PostgreSQL — local: postgresql://user:pass@localhost:5432/portfolio?sslmode=disable
# hosted (Neon/Supabase): copy the connection string from their dashboard
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Public site URL — used for canonical links and social share (Open Graph /
# Twitter) metadata so links unfurl with title, description and image.
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL; set this
# to pin the canonical production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# NextAuth v5 — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-char-random-secret

# Admin credentials
ADMIN_EMAIL=admin@example.com

# Use ONE of the following:
# ADMIN_PASSWORD — plain text (dev only, never in production)
ADMIN_PASSWORD=replace-with-strong-password

# ADMIN_PASSWORD_HASH — bcrypt hash (recommended, required in production)
# Generate: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
# ADMIN_PASSWORD_HASH=$2b$12$...

# Vercel Blob — set automatically if using Vercel Storage, or get from Vercel dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Integrations (cross-publishing) ────────────────────────────────────────────
# Optional: a dedicated 32-byte key (hex or base64) used to encrypt connected social/
# blog platform credentials at rest (AES-256-GCM). If unset, the key is derived from
# AUTH_SECRET, so cross-publishing works out-of-the-box. Set this to rotate/segregate
# the integration-credentials key independently of the auth secret.
# Generate: openssl rand -base64 32
# INTEGRATIONS_ENC_KEY=

# ─── Email (2FA OTP + password reset) ───────────────────────────────────────────
# The system tries SMTP first, then Mailgun. Configure at least one.

# SMTP (works with Gmail, SendGrid, Postfix, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# Mailgun (fallback)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=noreply@mg.yourdomain.com
# MAILGUN_REGION=eu   # uncomment for EU accounts
