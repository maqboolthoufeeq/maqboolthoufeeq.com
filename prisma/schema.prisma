generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  tech        String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  images      String[] @default([])
  order       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]    @relation("ProjectTags")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]     @relation("PostTags")
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  posts    Post[]    @relation("PostTags")
  projects Project[] @relation("ProjectTags")
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Stores OTP codes, password reset tokens, and pre-auth tokens
model AdminToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String   // 'otp' | 'reset' | 'preauth'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Tracks browsers that have completed OTP verification
model AdminBrowser {
  id        String   @id @default(cuid())
  browserId String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())
}

// Stores admin password hash (overrides env var when set)
model AdminSettings {
  id           String   @id @default("singleton")
  passwordHash String?
  updatedAt    DateTime @updatedAt
}
