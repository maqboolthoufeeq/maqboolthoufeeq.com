generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  tech        String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  images      String[] @default([])
  order       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]    @relation("ProjectTags")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  zaps        Int       @default(0)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]     @relation("PostTags")

  // Blog listings filter published=true ordered by publishedAt desc.
  @@index([published, publishedAt])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  posts     Post[]     @relation("PostTags")
  projects  Project[]  @relation("ProjectTags")
  hubTopics HubTopic[] @relation("HubTopicTags")
  hubItems  HubItem[]  @relation("HubItemTags")
}

// ─── Link Hub ────────────────────────────────────────────────────────────────
// A Linktree-style content hub: a tree of topics/subtopics, each holding rich
// content blocks (links, text, markdown, images, video, audio, pdf, files,
// embeds). Categories + Tags are cross-cutting facets used for search/filter.

// A flat, colour-coded facet an admin can attach to topics and content blocks
// to power the public filter chips (distinct from the topic hierarchy).
model HubCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  color     String?    // optional hex accent for the chip, validated server-side
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  topics    HubTopic[]
  items     HubItem[]
}

// A node in the hub tree: a main topic (parentId null) or a subtopic. Nests
// arbitrarily deep via the self-relation; deleting a node cascades to its
// children and their content.
model HubTopic {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?      // short summary shown in the list + detail header
  icon        String?      // optional emoji or lucide icon name
  coverImage  String?      // optional cover/thumbnail (blob or external https)
  order       Int          @default(0)
  published   Boolean      @default(true)
  showDate    Boolean      @default(false) // show the date publicly
  displayDate DateTime?    // overrides createdAt for the public date label + sort
  parentId    String?
  parent      HubTopic?    @relation("HubTopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    HubTopic[]   @relation("HubTopicTree")
  categoryId  String?
  category    HubCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items       HubItem[]
  tags        Tag[]        @relation("HubTopicTags")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentId])
  @@index([categoryId])
}

// A single content block inside a topic/subtopic. `type` discriminates the
// payload; every field is validated/sanitised per-type before storage so no
// unsafe scheme or markup is ever persisted (see lib/hub-content.ts).
model HubItem {
  id          String       @id @default(cuid())
  topicId     String
  topic       HubTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        String       // 'link'|'text'|'markdown'|'richtext'|'image'|'video'|'audio'|'pdf'|'file'|'embed'
  title       String
  description String?
  url         String?      // link / external media / embed source (http(s) only)
  fileUrl     String?      // uploaded blob url (image/video/audio/pdf/file)
  fileName    String?      // original display filename
  fileSize    Int?         // bytes, when known
  fileType    String?      // MIME type, when known
  content     String?      // text / markdown source / sanitised richtext HTML
  thumbnail   String?      // optional poster/thumbnail (http(s) only)
  images      Json?        // gallery: ordered [{url,fileName,fileSize,fileType}] for multi-photo `image` blocks
  order       Int          @default(0)
  published   Boolean      @default(true)
  showDate    Boolean      @default(false)
  displayDate DateTime?
  categoryId  String?
  category    HubCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        Tag[]        @relation("HubItemTags")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([topicId])
  @@index([type])
  @@index([categoryId])
}

// A topic / playlist that groups social media items (reels and videos), shown
// as its own row on the public "view all" pages — like a YouTube playlist.
model MediaCategory {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     MediaItem[]
}

// An Instagram reel or a YouTube video curated from the admin and showcased on
// the landing page + dedicated /reels and /videos pages.
model MediaItem {
  id              String         @id @default(cuid())
  platform        String         // 'instagram' | 'youtube'
  title           String
  description     String?
  sourceUrl       String         // original Instagram/YouTube URL the admin pasted
  embedId         String         // extracted shortcode (IG) or video id (YT)
  thumbnailUrl    String?        // custom thumbnail; YouTube auto-derives when blank
  previewVideoUrl String?        // optional short MP4 used for hover/scroll preview
  links           Json           @default("[]") // [{ label, url }] — related links shown publicly
  attachments     Json           @default("[]") // [{ name, url, size, type }] — downloadable files
  featured        Boolean        @default(false)
  published       Boolean        @default(true)
  showDate        Boolean        @default(false) // show the "added" date publicly
  displayDate     DateTime?      // overrides createdAt for the public date label
  order           Int            @default(0)
  categoryId      String?
  category        MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([platform])
  @@index([categoryId])
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A site-wide announcement / "latest" notice. The newest row with `active=true`
// is shown as a dismissible bar on top of the landing page; every row (active or
// not) is kept as a public + admin-visible history of past announcements.
model Banner {
  id        String   @id @default(cuid())
  message   String // the notice text shown in the bar + history
  linkLabel String? // optional call-to-action label
  linkUrl   String? // optional call-to-action url (http(s), mailto, tel or /path)
  variant   String   @default("info") // info | success | warning | announcement
  active    Boolean  @default(true) // currently displayed at the top of the site
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
}

// Single-row site-wide visitor analytics counters.
model SiteStats {
  id        String   @id @default("singleton")
  visitors  Int      @default(0) // unique browsers (deduped by cookie)
  pageViews Int      @default(0) // total public page loads
  updatedAt DateTime @updatedAt
}

// Stores OTP codes, password reset tokens, and pre-auth tokens
model AdminToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String   // 'otp' | 'reset' | 'preauth'
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // failed guesses against this token (OTP brute-force cap)
  createdAt DateTime @default(now())
}

// Tracks browsers that have completed OTP verification
model AdminBrowser {
  id        String   @id @default(cuid())
  browserId String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())
}

// Stores admin password hash (overrides env var when set)
model AdminSettings {
  id           String   @id @default("singleton")
  passwordHash String?
  updatedAt    DateTime @updatedAt
}

model ContactRequest {
  id             String   @id @default(cuid())
  name           String
  email          String
  message        String
  ip             String?
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  // The contact endpoint counts recent submissions per IP on every POST.
  @@index([ip, createdAt])
}

// Fixed-window rate-limit counters (see lib/rate-limit.ts). One row per key
// (e.g. "login:<ip>"); expired rows are opportunistically deleted.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model OAuthClient {
  id           String             @id @default(cuid())
  name         String
  clientId     String             @unique
  clientSecret String
  redirectUrls String[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  authCodes    OAuthAuthCode[]
  accessTokens OAuthAccessToken[]
}

model OAuthAuthCode {
  id            String      @id @default(cuid())
  code          String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUrl   String
  codeChallenge String?
  expiresAt     DateTime
  used          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model OAuthAccessToken {
  id        String       @id @default(cuid())
  token     String       @unique
  label     String       @default("Access Token")
  clientId  String?
  client    OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}
