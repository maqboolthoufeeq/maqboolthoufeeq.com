generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  tech        String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  images      String[] @default([])
  order       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]    @relation("ProjectTags")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  zaps        Int       @default(0)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]     @relation("PostTags")
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  posts    Post[]    @relation("PostTags")
  projects Project[] @relation("ProjectTags")
}

// A topic / playlist that groups social media items (reels and videos), shown
// as its own row on the public "view all" pages — like a YouTube playlist.
model MediaCategory {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     MediaItem[]
}

// An Instagram reel or a YouTube video curated from the admin and showcased on
// the landing page + dedicated /reels and /videos pages.
model MediaItem {
  id              String         @id @default(cuid())
  platform        String         // 'instagram' | 'youtube'
  title           String
  description     String?
  sourceUrl       String         // original Instagram/YouTube URL the admin pasted
  embedId         String         // extracted shortcode (IG) or video id (YT)
  thumbnailUrl    String?        // custom thumbnail; YouTube auto-derives when blank
  previewVideoUrl String?        // optional short MP4 used for hover/scroll preview
  featured        Boolean        @default(false)
  published       Boolean        @default(true)
  showDate        Boolean        @default(false) // show the "added" date publicly
  displayDate     DateTime?      // overrides createdAt for the public date label
  order           Int            @default(0)
  categoryId      String?
  category        MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([platform])
  @@index([categoryId])
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Single-row site-wide visitor analytics counters.
model SiteStats {
  id        String   @id @default("singleton")
  visitors  Int      @default(0) // unique browsers (deduped by cookie)
  pageViews Int      @default(0) // total public page loads
  updatedAt DateTime @updatedAt
}

// Stores OTP codes, password reset tokens, and pre-auth tokens
model AdminToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String   // 'otp' | 'reset' | 'preauth'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Tracks browsers that have completed OTP verification
model AdminBrowser {
  id        String   @id @default(cuid())
  browserId String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())
}

// Stores admin password hash (overrides env var when set)
model AdminSettings {
  id           String   @id @default("singleton")
  passwordHash String?
  updatedAt    DateTime @updatedAt
}

model ContactRequest {
  id             String   @id @default(cuid())
  name           String
  email          String
  message        String
  ip             String?
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model OAuthClient {
  id           String             @id @default(cuid())
  name         String
  clientId     String             @unique
  clientSecret String
  redirectUrls String[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  authCodes    OAuthAuthCode[]
  accessTokens OAuthAccessToken[]
}

model OAuthAuthCode {
  id            String      @id @default(cuid())
  code          String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUrl   String
  codeChallenge String?
  expiresAt     DateTime
  used          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model OAuthAccessToken {
  id        String       @id @default(cuid())
  token     String       @unique
  label     String       @default("Access Token")
  clientId  String?
  client    OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}
